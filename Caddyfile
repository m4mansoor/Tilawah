# Tilawah - Caddy reverse proxy (automatic HTTPS via Let's Encrypt).
# Serves the Qari web dashboard and proxies /v1, /health and /docs to the API.

tilawah.me {
	encode gzip

	# API + docs.
	handle /v1/* {
		reverse_proxy api:8000
	}
	handle /health {
		reverse_proxy api:8000
	}
	handle /docs* {
		reverse_proxy api:8000
	}
	handle /openapi.json {
		reverse_proxy api:8000
	}

	# Everything else -> web dashboard (nginx SPA).
	handle {
		reverse_proxy web:80
	}
}

www.tilawah.me {
	redir https://tilawah.me{uri}
}
