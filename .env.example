# Docker Compose environment — copy to `.env` on the VPS and set real secrets.

# PostgreSQL (must match docker-compose.yml usage)
POSTGRES_PASSWORD=change-this-strong-password

# API
JWT_SECRET=change-this-to-a-long-random-string
MODEL_ID=/root/.cache/huggingface/quran-ct2
DEVICE=-1
AUDIO_DIR=/data/audio
ADMIN_EMAILS=you@example.com
