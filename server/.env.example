# Copy to .env and adjust as needed. All values can also be set via environment.

# ASR model (all Apache-2.0, ungated):
#   tarteel-ai/whisper-base-ar-quran                         (74M,  CPU-friendly)
#   MaddoggProduction/whisper-l-v3-turbo-quran-lora-dataset-mix (809M, higher accuracy)
MODEL_ID=tarteel-ai/whisper-base-ar-quran

# -1 = CPU, 0 = first GPU, 1 = second GPU, ...
DEVICE=-1

REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql://tilawah:tilawah@localhost:5432/tilawah
MAX_AUDIO_SECONDS=300
JWT_SECRET=change-this-to-a-long-random-string
