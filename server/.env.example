# Copy to .env and adjust as needed. All values can also be set via environment.

# ASR model (all Apache-2.0, ungated). The default is the converted Quran-tuned
# model produced by scripts/convert_model.sh (see that script for the source).
#   /root/.cache/huggingface/quran-ct2                       (Quran-fine-tuned) [default]
#   large-v3-turbo                                           (vanilla fallback)
#   tarteel-ai/whisper-base-ar-quran                         (74M, CPU-friendly, older)
MODEL_ID=/root/.cache/huggingface/quran-ct2

# -1 = CPU, 0 = first GPU, 1 = second GPU, ...
DEVICE=-1

# ASR execution backend: "local" (CPU/GPU per DEVICE) or "modal" (serverless L4 GPU).
ASR_BACKEND=local
# Beam size: 5 = more accurate / slower, 1 = greedy / ~3-4x faster.
ASR_BEAM_SIZE=5
# Deployed Modal app name (only used when ASR_BACKEND=modal).
MODAL_ASR_NAME=tilawah-asr
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=

REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql://tilawah:tilawah@localhost:5432/tilawah
MAX_AUDIO_SECONDS=300
JWT_SECRET=change-this-to-a-long-random-string

# Where collected Qari training recitations are stored.
AUDIO_DIR=data/audio

# Comma-separated emails to auto-promote to admin (review queue access).
ADMIN_EMAILS=you@example.com
